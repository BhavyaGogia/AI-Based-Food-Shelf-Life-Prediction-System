# Frontend environment variables (Vite)
# Add these to your Vercel project's Environment Variables dashboard.
# DO NOT commit a .env file with real values to git.

# Full URL of your Render backend (no trailing slash)
# Example: https://himshakti-api.onrender.com
VITE_API_URL=https://your-backend-name.onrender.com

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
