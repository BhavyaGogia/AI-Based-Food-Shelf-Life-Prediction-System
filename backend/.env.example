# Backend environment variables (Node/Express)
# Add these to your Render Web Service's Environment Variables dashboard.
# DO NOT commit a .env file with real values to git.

# MongoDB Atlas connection string
# Get from: cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/himshakti

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT secret — use a random string of at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Server port (Render sets this automatically — keep $PORT)
# Environment variables required for local development and Vercel production deployment
PORT=5050
NODE_ENV=development
NODE_ENV=production

# Production frontend URL (your Vercel URL — update after Vercel deploy)
FRONTEND_URL=https://your-app.vercel.app

# Google OAuth Client ID (same value as VITE_GOOGLE_CLIENT_ID on Vercel)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
