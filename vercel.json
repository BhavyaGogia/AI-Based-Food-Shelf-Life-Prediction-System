{
    "version": 2,
    "functions": {
          "api/index.cjs": {
                  "maxDuration": 60
          }
    },
    "rewrites": [
          {
                  "source": "/api/(.*)",
                  "destination": "/api/index.cjs"
          },
          {
                  "source": "/health",
                  "destination": "/api/index.cjs"
          },
          {
                  "source": "/(.*)",
                  "destination": "/index.html"
          }
    ]
}
